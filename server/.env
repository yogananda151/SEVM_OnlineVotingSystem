NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://root:Yoga@1234@localhost:3306/voting_system"
JWT_SECRET=smart_evm_super_secret_jwt_key_2025_change_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=smart_evm_refresh_secret_key_2025_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
# Dedicated HMAC secret for Aadhaar hashing — MUST differ from JWT_SECRET in production
AADHAAR_HMAC_SECRET=smart_evm_aadhaar_hmac_secret_2025_change_in_production
CLIENT_URL=http://localhost:5173
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOG_LEVEL=info
LOG_FILE=./logs/app.log
