// This is the Prisma schema for the Online Voting System
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  COMMISSIONER
  OFFICER
}

enum ElectionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  CLOSED
  RESULTS_PUBLISHED
}

enum MachineStatus {
  IDLE
  ACTIVE
  LOCKED
  PAUSED
  CLOSED
}

enum VerificationMethod {
  AADHAAR
  VOTER_ID
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VOTE_CAST
  VERIFY_VOTER
  LOCK_MACHINE
  UNLOCK_MACHINE
  PAUSE_POLLING
  RESUME_POLLING
  CLOSE_POLLING
  PUBLISH_RESULTS
  BACKUP
  RESTORE
  EXPORT
}

// ─────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(255)
  role          UserRole
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  commissioner  ElectionCommissioner?
  officer       ElectionOfficer?
  loginLogs     LoginLog[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model ElectionCommissioner {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  fullName    String   @db.VarChar(150)
  employeeId  String   @unique @db.VarChar(50)
  phone       String   @db.VarChar(20)
  designation String   @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("election_commissioners")
}

model ElectionOfficer {
  id               Int            @id @default(autoincrement())
  userId           Int            @unique
  fullName         String         @db.VarChar(150)
  employeeId       String         @unique @db.VarChar(50)
  phone            String         @db.VarChar(20)
  pollingStationId Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pollingStation   PollingStation? @relation(fields: [pollingStationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pollingStationId])
  @@map("election_officers")
}

// ─────────────────────────────────────────────
// ELECTION STRUCTURE
// ─────────────────────────────────────────────

model Election {
  id               Int             @id @default(autoincrement())
  name             String          @db.VarChar(200)
  description      String?         @db.Text
  electionType     String          @db.VarChar(100)
  scheduledDate    DateTime
  startTime        DateTime?
  endTime          DateTime?
  status           ElectionStatus  @default(DRAFT)
  isResultPublished Boolean        @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  constituencies   Constituency[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@index([status])
  @@index([scheduledDate])
  @@map("elections")
}

model Constituency {
  id               Int              @id @default(autoincrement())
  electionId       Int
  name             String           @db.VarChar(200)
  code             String           @db.VarChar(50)
  state            String           @db.VarChar(100)
  district         String           @db.VarChar(100)
  totalVoters      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  election         Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  pollingStations  PollingStation[]
  candidates       Candidate[]
  voters           Voter[]

  @@unique([electionId, code])
  @@index([electionId])
  @@map("constituencies")
}

model PollingStation {
  id               Int            @id @default(autoincrement())
  constituencyId   Int
  name             String         @db.VarChar(200)
  code             String         @db.VarChar(50)
  address          String         @db.Text
  totalBooths      Int            @default(1)
  machineStatus    MachineStatus  @default(IDLE)
  isPollingActive  Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  constituency     Constituency   @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  officers         ElectionOfficer[]
  voters           Voter[]
  votes            Vote[]

  @@unique([constituencyId, code])
  @@index([constituencyId])
  @@map("polling_stations")
}

// ─────────────────────────────────────────────
// PARTIES & CANDIDATES
// ─────────────────────────────────────────────

model PoliticalParty {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(200)
  abbreviation String      @db.VarChar(20)
  symbol       String?     @db.VarChar(255)
  symbolUrl    String?     @db.VarChar(500)
  color        String      @db.VarChar(7) @default("#1a73e8")
  foundedYear  Int?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  candidates   Candidate[]

  @@index([name])
  @@map("political_parties")
}

model Candidate {
  id               Int             @id @default(autoincrement())
  constituencyId   Int
  partyId          Int?
  fullName         String          @db.VarChar(150)
  photoUrl         String?         @db.VarChar(500)
  age              Int
  qualification    String?         @db.VarChar(200)
  serialNumber     Int
  isIndependent    Boolean         @default(false)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  constituency     Constituency    @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  party            PoliticalParty? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  votes            Vote[]
  vvpatRecords     DigitalVVPAT[]

  @@index([constituencyId])
  @@index([partyId])
  @@map("candidates")
}

// ─────────────────────────────────────────────
// VOTERS
// ─────────────────────────────────────────────

model Voter {
  id                Int                 @id @default(autoincrement())
  constituencyId    Int
  pollingStationId  Int
  fullName          String              @db.VarChar(150)
  voterId           String              @unique @db.VarChar(50)
  aadhaarHash       String?             @db.VarChar(64)
  dateOfBirth       DateTime
  gender            String              @db.VarChar(10)
  address           String              @db.Text
  phone             String?             @db.VarChar(20)
  photoUrl          String?             @db.VarChar(500)
  serialNumber      Int
  hasVoted          Boolean             @default(false)
  votedAt           DateTime?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  constituency      Constituency        @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  pollingStation    PollingStation      @relation(fields: [pollingStationId], references: [id], onDelete: Cascade)
  vote              Vote?
  otpVerifications  OTPVerification[]

  @@index([voterId])
  @@index([constituencyId])
  @@index([pollingStationId])
  @@index([hasVoted])
  @@map("voters")
}

// ─────────────────────────────────────────────
// VOTING
// ─────────────────────────────────────────────

model Vote {
  id               Int          @id @default(autoincrement())
  voterId          Int          @unique
  candidateId      Int
  pollingStationId Int
  voteHash         String       @unique @db.VarChar(64)
  referenceNumber  String       @unique @db.VarChar(50)
  isVerified       Boolean      @default(false)
  castAt           DateTime     @default(now())

  voter            Voter        @relation(fields: [voterId], references: [id], onDelete: Restrict)
  candidate        Candidate    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  pollingStation   PollingStation @relation(fields: [pollingStationId], references: [id], onDelete: Restrict)
  vvpat            DigitalVVPAT?

  @@index([candidateId])
  @@index([pollingStationId])
  @@index([castAt])
  @@map("votes")
}

model DigitalVVPAT {
  id              Int       @id @default(autoincrement())
  voteId          Int       @unique
  candidateId     Int
  candidateName   String    @db.VarChar(150)
  partyName       String    @db.VarChar(200)
  partySymbolUrl  String?   @db.VarChar(500)
  electionName    String    @db.VarChar(200)
  referenceNumber String    @db.VarChar(50)
  voteHash        String    @db.VarChar(64)
  timestamp       DateTime  @default(now())

  vote            Vote      @relation(fields: [voteId], references: [id], onDelete: Cascade)
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([voteId])
  @@index([candidateId])
  @@map("digital_vvpat")
}

// ─────────────────────────────────────────────
// VERIFICATION & OTP
// ─────────────────────────────────────────────

model OTPVerification {
  id         Int                @id @default(autoincrement())
  voterId    Int
  otp        String             @db.VarChar(6)
  method     VerificationMethod
  status     VerificationStatus @default(PENDING)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())

  voter      Voter              @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@index([voterId])
  @@index([otp])
  @@map("otp_verifications")
}

// ─────────────────────────────────────────────
// LOGS & AUDIT
// ─────────────────────────────────────────────

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      Int?
  electionId  Int?
  action      AuditAction
  module      String      @db.VarChar(100)
  description String      @db.Text
  ipAddress   String?     @db.VarChar(45)
  userAgent   String?     @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime    @default(now())

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  election    Election?   @relation(fields: [electionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([electionId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  ipAddress  String   @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  success    Boolean
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_logs")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS & SETTINGS
// ─────────────────────────────────────────────

model Notification {
  id         Int      @id @default(autoincrement())
  electionId Int?
  title      String   @db.VarChar(200)
  message    String   @db.Text
  type       String   @db.VarChar(50) @default("info")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  election   Election? @relation(fields: [electionId], references: [id], onDelete: SetNull)

  @@index([electionId])
  @@index([isRead])
  @@map("notifications")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  group     String   @db.VarChar(50) @default("general")
  label     String   @db.VarChar(200)
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("settings")
}
