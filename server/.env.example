# ==============================================================================
# SMART EVM BACKEND CONFIGURATION
# Copy this file to .env for local development: cp .env.example .env
# For cloud deployment (Render), configure these keys in the Render Dashboard.
# ==============================================================================

# Runtime Environment (development | production | test)
ENV=development

# Server Network Binding
HOST=0.0.0.0
PORT=5000

# Database Connection (MySQL / TiDB Cloud Starter)
# Local MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/voting_system
# TiDB Cloud (example format - Render backend will connect using your TiDB cluster credentials):
# DATABASE_URL=mysql+pymysql://<username>:<password>@<gateway-host>:4000/voting_system?ssl_verify_cert=true&ssl_verify_identity=true

# Cryptographic Secrets (MUST be distinct, random, minimum 32 characters in production)
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_random_jwt_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_min_32_char_random_refresh_secret_distinct_from_jwt
JWT_REFRESH_EXPIRES_IN=7d
AADHAAR_HMAC_SECRET=replace_with_min_32_char_random_secret_for_aadhaar_simulation_hashing

# Allowed Frontend Origins for CORS (Vercel production URL or comma-separated list)
CLIENT_URL=http://localhost:5173

# File Storage Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Optional: Initial Demonstration Account Passwords for `python scripts/seed.py`
# Required when seeding on a fresh database to avoid default or hardcoded credentials.
SEED_COMMISSIONER_PASSWORD=
SEED_OFFICER_PASSWORD=
